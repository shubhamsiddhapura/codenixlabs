{
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "https://api.codenixlabs.com/api/blogs/og/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(linkedinbot|twitterbot|facebookexternalhit|whatsapp|telegrambot|slackbot|discordbot|twitterbot|whatsapp)"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}